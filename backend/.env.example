APP_NAME=AppMovil API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Origenes exactos autorizados (separados por coma). En produccion agregue el
# origen HTTPS real del frontend, por ejemplo https://app.sumasas.com.co.
# No use *: la web debe tener un origen explícito para CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Regex opcional para origenes dinamicos (Expo Web en cualquier puerto local).
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
LOG_DIR=logs

# URL de la base PostgreSQL que contiene DW_SUMA y DW_CONFIG.
# En Docker, use un hostname/IP accesible desde el contenedor.
DATABASE_URL=postgresql+psycopg2://usuario:contrasena@host.docker.internal:5432/base_kactus

# Genere una clave aleatoria de al menos 32 bytes.
# Ejemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Para Docker en Linux con FUSE ya montado en la raíz EvidenciasAppMovil,
# configure ambos valores con esa ruta (en host y dentro del contenedor):
# EVIDENCIAS_HOST_PATH=/mnt/evidencias_appmovil
# EVIDENCIAS_CONTAINER_PATH=/mnt/evidencias_appmovil
# Ruta accesible y escribible por la API. En Windows, usar la ruta UNC de red.
EVIDENCIAS_PATH=\\172.20.10.32\web

# Caché persistente de evidencias (volumen Docker: appmovil-evidence-cache).
# Cuotas separadas: miniaturas 512 MiB, originales 1.5 GiB y videos 512 MiB.
EVIDENCE_CACHE_PATH=/var/cache/appmovil
EVIDENCE_CACHE_VOLUME_NAME=appmovil-evidence-cache
EVIDENCE_THUMBNAIL_CACHE_MAX_BYTES=536870912
EVIDENCE_ORIGINAL_CACHE_MAX_BYTES=1610612736
EVIDENCE_VIDEO_CACHE_MAX_BYTES=536870912
EVIDENCE_VIDEO_CACHE_MAX_FILE_BYTES=16777216
EVIDENCE_CACHE_EXPIRY_SECONDS=604800
EVIDENCE_CACHE_CLEANUP_INTERVAL_SECONDS=3600

# Genere con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EXPO_PUSH_TOKEN_ENCRYPTION_KEY=
# Opcional; se requiere solo si el proyecto Expo tiene habilitada la autenticacion push.
EXPO_ACCESS_TOKEN=
EXPO_POLL_INTERVAL_SECONDS=60
EXPO_POLL_BATCH_SIZE=100
