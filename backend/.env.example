APP_NAME=AppMovil API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
LOG_DIR=logs

# URL de la base PostgreSQL que contiene DW_SUMA y DW_CONFIG.
# En Docker, use un hostname/IP accesible desde el contenedor.
DATABASE_URL=postgresql+psycopg://host.docker.internal:5432/DATABASE_NAME

# Genere una clave aleatoria de al menos 32 bytes.
# Ejemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Genere con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EXPO_PUSH_TOKEN_ENCRYPTION_KEY=
# Opcional; se requiere solo si el proyecto Expo tiene habilitada la autenticacion push.
EXPO_ACCESS_TOKEN=
EXPO_POLL_INTERVAL_SECONDS=60
EXPO_POLL_BATCH_SIZE=100
