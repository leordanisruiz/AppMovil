{
  "expo": {
    "name": "Portal Operadores",
    "slug": "portal-operadores",
    "version": "1.1.9",
    "orientation": "portrait",
    "icon": "./assets/brand-logo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF0000",
          "defaultChannel": "novedades"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Portal Operadores necesita acceso a tus fotos para adjuntarlas como evidencia.",
          "cameraPermission": "Portal Operadores necesita acceso a la cámara para tomar evidencias.",
          "microphonePermission": "Portal Operadores necesita acceso al micrófono para incluir audio en las evidencias de video."
        }
      ],
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Portal Operadores necesita acceso a tu galería para guardar las evidencias descargadas.",
          "savePhotosPermission": "Portal Operadores guarda las evidencias descargadas en tu galería."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-image"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.sumaaplicaciones.portaloperadores",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand-logo.png",
        "monochromeImage": "./assets/brand-symbol.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2cc6329a-65e7-4e94-831e-dc0307de10e1"
      }
    },
    "owner": "leordanis.ruiz",
  "experiments": {
    "baseUrl": "/operadores"
  }
  }
}
